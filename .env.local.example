# ──────────────────────────────────────────────────────────────
# Duffel API token.
# Copy this file to `.env.local` and paste your sandbox token below.
# Get one at: https://app.duffel.com  →  Developers  →  Access tokens
# A sandbox/test token starts with:  duffel_test_...
# A live token starts with:          duffel_live_...
# Keep this file PRIVATE — never commit .env.local to git.
# ──────────────────────────────────────────────────────────────
DUFFEL_API_TOKEN=duffel_test_paste_your_token_here

# Duffel API version pinned by this app. Don't change unless you
# know the payload shapes have changed.
DUFFEL_API_VERSION=v2
